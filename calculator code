#include <stdio.h> 
#include <math.h>

int main() 
{
    float a,b,c;
    char ch;
    
   printf("enter number 1\n");
   scanf("%f",&a);
   
   printf("enter number 2\n");
   scanf("%f",&b);
   
   printf("enter operation\n");
   scanf(" %c",&ch);
   //add a spcae whenever u want to take a character input
   
   if(ch=='*'){
       c=a*b;
       printf("%f",c);
   }
  else if(ch=='+'){
       c=a+b;
       printf("%f",c);
   }
  else if(ch=='/' && b!=0){
       c=a/b;
       printf("%f",c);
   }
  else if(ch=='-'){
       c=a-b;
       printf("%f",c);
   }
  
    return 0;
}
